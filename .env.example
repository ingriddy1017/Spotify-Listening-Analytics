# Copy this file to .env and fill in your own values.
# Get these from https://developer.spotify.com/dashboard after creating an app.

SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:3000

# Optional. Fills in genres for artists Spotify's API won't give genres for
# (its batch artist-lookup endpoint is restricted in Development Mode as of
# 2026 - see NOTES_ON_API_ACCESS.md). Free, no business/MAU requirement:
# get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_client_id_here
